<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MD卡图查看替换器</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>true</PublishSingleFile>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	<PublishTrimmed>false</PublishTrimmed>
	<DebugType>None</DebugType>
	<DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <Version>2.0.9</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
	<Win32Icon>Resources\app-icon.ico</Win32Icon>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <Compile Remove="ApplicationConfiguration.cs" />
    <Compile Remove="--z__ReadOnlySingleElementList.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\visual-assets-v1.tsv" LogicalName="MdCardModTool.visual-assets-v1.tsv" />
	<Content Include="Resources\card-catalog-v1.json.br" Link="data\card-catalog-v1.json.br" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<Content Include="Resources\prebuilt-animation-index-v1.json.br" Link="data\prebuilt-animation-index-v1.json.br" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\app-icon-rounded.png" Link="data\app-icon-rounded.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<Content Include="Resources\app-icon.ico" Link="data\app-icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<Content Include="Resources\CardFrames\*.png" Link="data\CardFrames\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<Content Include="Resources\FloowanFrames\*.png" Link="data\CardFrames\Floowan\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<Content Include="Resources\OverFrameTemplates\**\*.png" Link="data\OverFrameTemplates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\visual-assets-v1.tsv" Link="data\visual-assets-v1.tsv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\classdata.tpk" Link="data\classdata.tpk" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\prebuilt-index-v1.json.br" Link="data\prebuilt-index-v1.json.br" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\monster-animation-cards-v1.txt" Link="data\monster-animation-cards-v1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\tools\**\*" Link="data\tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="DIRECTXTEX-NOTICE.txt" Link="data\licenses\DIRECTXTEX-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="FFMPEG-NOTICE.txt" Link="data\licenses\FFMPEG-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="data\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<None Include="..\RELEASE-NOTES-v2.0.9.md" Link="data\RELEASE-NOTES-v2.0.9.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<None Include="..\THIRD_PARTY_NOTICES.md" Link="data\licenses\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<None Include="..\FLOOWAN-NOTICE.txt" Link="data\licenses\FLOOWAN-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\ASTELLAR-NOTICE.txt" Link="data\licenses\ASTELLAR-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\TEST-REPORT.md" Link="data\TEST-REPORT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<None Include="..\LICENSE" Link="data\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	<None Update="使用说明-v2.0.txt" Link="data\使用说明-v2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="启动 MD卡图查看替换器.bat" Link="data\启动 MD卡图查看替换器.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="首次启动-解除下载封锁.bat" Link="data\首次启动-解除下载封锁.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
  </ItemGroup>
	<ItemGroup>
		<Content Include="$(NuGetPackageRoot)\skiasharp\2.88.9\LICENSE.txt" Link="data\licenses\SkiaSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)\skiasharp\2.88.9\LICENSE.txt')" />
		<Content Include="$(NuGetPackageRoot)\skiasharp\2.88.9\THIRD-PARTY-NOTICES.txt" Link="data\licenses\SkiaSharp-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)\skiasharp\2.88.9\THIRD-PARTY-NOTICES.txt')" />
	</ItemGroup>
  <ItemGroup>
    <Reference Include="AssetRipper.TextureDecoder">
      <HintPath>Assets\lib\AssetRipper.TextureDecoder.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssetsTools.NET">
      <HintPath>Assets\lib\AssetsTools.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssetsTools.NET.Texture">
      <HintPath>Assets\lib\AssetsTools.NET.Texture.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
	<Target Name="EnsureCriticalPublishedData" AfterTargets="Publish">
		<ItemGroup>
			<_CriticalPublishedData Include="Assets\prebuilt-index-v1.json.br"
				Destination="$(PublishDir)data\prebuilt-index-v1.json.br" />
			<_CriticalPublishedData Include="Resources\app-icon.ico"
				Destination="$(PublishDir)data\app-icon.ico" />
			<_CriticalPublishedData Include="Assets\tools\texconv.exe"
				Destination="$(PublishDir)data\tools\texconv.exe" />
			<_CriticalPublishedData Include="Assets\tools\ffmpeg.exe"
				Destination="$(PublishDir)data\tools\ffmpeg.exe"
				Condition="Exists('Assets\tools\ffmpeg.exe')" />
		</ItemGroup>
		<Copy SourceFiles="@(_CriticalPublishedData)"
			DestinationFiles="@(_CriticalPublishedData->'%(Destination)')"
			SkipUnchangedFiles="true" />
		<Error Condition="!Exists('$(PublishDir)data\prebuilt-index-v1.json.br')"
			Text="发布包缺少 data\prebuilt-index-v1.json.br。" />
		<Error Condition="!Exists('$(PublishDir)data\app-icon.ico')"
			Text="发布包缺少 data\app-icon.ico。" />
		<Error Condition="!Exists('$(PublishDir)data\tools\texconv.exe')"
			Text="发布包缺少 data\tools\texconv.exe。" />
		<Warning Condition="!Exists('Assets\tools\ffmpeg.exe')"
			Text="源码仓库未包含 FFmpeg；正式 Release 打包前必须把 ffmpeg.exe 放入 Assets\tools。" />
	</Target>
</Project>
